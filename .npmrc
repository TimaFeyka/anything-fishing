# Render (и любой CI) выставляет NODE_ENV=production, а npm в этом режиме по умолчанию
# НЕ устанавливает devDependencies. Из-за этого сборка падает с "vite: not found",
# потому что Vite и TypeScript лежат в devDependencies.
# Эта настройка заставляет npm всегда ставить dev-зависимости, пока установка не
# переопределена явным флагом (npm ci --omit=dev).
include=dev

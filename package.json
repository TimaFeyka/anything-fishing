{
  "name": "anything-fishing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ANYTHING FISHING — Telegram Mini App про рыбалку, коллекционирование и неизвестные находки",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "npm run build:server && node scripts/engine-test.mjs",
    "test:balance": "node scripts/balance-test.mjs",
    "test:ui": "node scripts/render-check.mjs",
    "test:pg": "node scripts/pg-test.mjs",
    "pg:server": "node scripts/pg-server.mjs",
    "test:api": "node scripts/smoke.mjs",
    "test:ws": "node scripts/ws-test.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}

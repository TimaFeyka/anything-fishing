# ── Telegram ──────────────────────────────────────────────────────────────────
# Токен бота из @BotFather. Нужен для проверки initData и для платежей в Stars.
TELEGRAM_BOT_TOKEN=
# Юзернейм бота без @ (для ссылок вида t.me/<bot>/<short_name>)
TELEGRAM_BOT_USERNAME=
# Имя Mini App, заданное в BotFather (/newapp). Используется в реферальных ссылках.
TELEGRAM_APP_SHORT_NAME=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=production
# Публичный адрес сервиса (Render выдаёт сам). Нужен для абсолютных ссылок.
PUBLIC_URL=
# Разрешить dev-авторизацию без Telegram (для локального запуска и тестов).
# ВСЕГДА оставляйте 0 в проде.
ALLOW_DEV_AUTH=1
# Секрет для подписи внутренних токенов сессии (сгенерируйте случайный)
SESSION_SECRET=change-me-to-a-long-random-string

# ── База данных ───────────────────────────────────────────────────────────────
# Render Postgres подставляет DATABASE_URL автоматически (Internal URL).
# Если переменная не задана, сервер работает на файловом хранилище (data/state.json).
# Это удобно локально, но на Render диск эфемерный — в проде обязателен Postgres.
DATABASE_URL=
# Для Render Internal URL нужен SSL off; для внешнего URL поставьте 1
PGSSL=0

# ── Экономика / защита ────────────────────────────────────────────────────────
# Лимит NPC-продаж в день: сначала полная цена, затем половина, затем стоп.
NPC_FULL_LIMIT=100
NPC_HALF_LIMIT=100
NPC_HALF_MULT=0.5
# Дней неактивности до "Возврата в пучину" для циркулирующих серийных находок
SERIAL_RETURN_DAYS=60
# Комиссия рынка игроков
MARKET_FEE=0.05

# ── Монетизация ───────────────────────────────────────────────────────────────
# Никакой игровой валюты и преимуществ за Stars — только косметика.
STARS_ENABLED=1
